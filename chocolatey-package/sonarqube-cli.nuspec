<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>sonarqube-cli</id>
    <version>__VERSION__</version>
    <title>SonarQube CLI</title>
    <authors>SonarSource</authors>
    <owners>SonarSource</owners>
    <projectUrl>https://docs.sonarsource.com/sonarqube-cli</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/SonarSource/sonarqube-cli@f5f1b31a6dea80537964140a0cbfe4e39567bb18/chocolatey-package/icon.png</iconUrl>
    <licenseUrl>https://github.com/SonarSource/sonarqube-cli/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/SonarSource/sonarqube-cli</projectSourceUrl>
    <packageSourceUrl>https://github.com/SonarSource/sonarqube-cli/tree/master/chocolatey-package</packageSourceUrl>
    <docsUrl>https://docs.sonarsource.com/sonarqube-cli</docsUrl>
    <bugTrackerUrl>https://github.com/SonarSource/sonarqube-cli/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/SonarSource/sonarqube-cli/releases/tag/__VERSION__</releaseNotes>
    <summary>Code quality and security for terminal workflows, scripts, and AI agents</summary>
    <description>The SonarQube CLI (sonar) is a command-line companion for SonarQube Cloud and SonarQube Server. It lets you scan for secrets, analyze local changes, query projects and issues, and wire SonarQube into AI coding assistants, all from your terminal.</description>
    <tags>sonar sonarqube cli static-analysis code-quality</tags>
  </metadata>
  <files>
    <file src="tools/**" target="tools" />
  </files>
</package>
