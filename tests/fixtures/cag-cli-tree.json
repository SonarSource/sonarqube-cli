          "about": "Get type hierarchy for a fully qualified name",
          "options": [
            {
              "long": "fqn",
              "value_name": "FQN",
              "help": "Fully qualified name",
              "required": false
            },
            {
              "long": "fqn-stdin",
              "help": "Read FQNs from stdin (one per line)",
