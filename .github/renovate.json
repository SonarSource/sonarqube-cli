{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config:ide-xp-team"
  ],
  "packageRules": [
    {
      "description": "Regenerate Bun lockfile after dependency updates",
      "matchManagers": [
        "bun"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bun install"
        ],
        "fileFilters": [
          "bun.lock",
          "bun.lockb"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
