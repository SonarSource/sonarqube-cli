{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config:ide-xp-team"
  ],
  "packageRules": [
    {
      "description": "Regenerate Bun lockfile after dependency updates",
      "matchManagers": [
        "bun"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bun install"
        ],
        "fileFilters": [
          "bun.lock"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/commands/admin/onboard-ci/github/templates\\.ts$/"
      ],
      "matchStrings": [
        "const (?:CHECKOUT|SCAN)_ACTION\\s*=\\s*'(?<depName>[^'@]+)@(?<currentDigest>[a-f0-9]{40})'; // (?<currentValue>v[0-9.]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
